{# templates/dashboard/hr.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}HR Dashboard{% endblock %}

{% block body %}
    <h1>Welcome to the HR Dashboard</h1>

    <p>Hello {{ app.user.name }} </p>
<ul>
    <li><a href="{{ path('hr_view_employees') }}">View All Employees</a></li>
    <li><a href="{{ path('hr_add_employee') }}">Add New Employee</a></li>
    <li><a href="{{ path('hr_view_attendance') }}">View Attendance Records</a></li>
    <li><a href="{{ path('hr_view_payslips') }}">View Employee Payslips</a></li>
</ul>


<form id="logout-form" action="{{ path('app_logout') }}" method="post" style="display: inline;">
    <button type="submit">🚪 Logout</button>
</form>


{% endblock %}
