{% extends 'base.html.twig' %}
{% block title %}Attendance Records{% endblock %}
{% block body %}
<h1>Employee Attendance</h1>

<table border="1">
    <tr>
        <th>Date</th>
        <th>Status</th>
    </tr>
    {% for record in records %}
        <tr>
            <td>{{ record.date|date('Y-m-d') }}</td>
            <td>{{ record.status }}</td>
        </tr>
    {% endfor %}

<a href="{{ path('hr_dashboard') }}">🔙 Back</a>
{% endblock %}
