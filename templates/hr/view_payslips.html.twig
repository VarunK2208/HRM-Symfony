{% extends 'base.html.twig' %}
{% block title %}Payslip Records{% endblock %}
{% block body %}
<h1>Employee Payslips</h1>

<table border="1">
    <tr>
        <th>Month</th>
        <th>Amount</th>
    </tr>
    {% for slip in payslips %}
        <tr>
            <td>{{ slip.month }}</td>
            <td>{{ slip.amount }}</td>
        </tr>
    {% endfor %}
</table>
<a href="{{ path('hr_dashboard') }}">🔙 Back</a>
{% endblock %}
